{
  "name": "finance-project",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "lotus_api",
    "lotus_web"
  ],
  "scripts": {
    "frontend": "npm run dev --workspace=lotus_web",
    "backend": "npm run start:dev --workspace=lotus_api",
    "dev": "concurrently \"npm run frontend\" \"npm run backend\"",
    "build:frontend": "npm run build --workspace=lotus_web",
    "build:backend": "npm run build --workspace=lotus_api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
